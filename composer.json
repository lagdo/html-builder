{
    "name": "lagdo/html-builder",
    "type": "library",
    "description": "A full-featured HTML builder with a fluent api.",
    "authors": [
        {
            "name": "Thierry Feuzeu",
            "email": "thierry.feuzeu@gmail.com"
        }
    ],
    "homepage": "https://github.com/lagdo/html-builder",
    "license": "MIT",
    "keywords": ["UI", "HTML", "Builder"],
    "support": {
        "issues": "https://github.com/lagdo/html-builder/issues",
        "source": "https://github.com/lagdo/html-builder"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "php-coveralls/php-coveralls": "^2.5",
        "phpunit/phpcov": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "Lagdo\\HtmlBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lagdo\\HtmlBuilder\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@clearCache",
            "@putenv XDEBUG_MODE=coverage",
            "vendor/bin/phpunit"
        ],
        "clearCache": "rm -rf cache/*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
